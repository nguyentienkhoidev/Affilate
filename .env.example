# =============================================================================
# HeyGoodly Affiliate & Editorial Reviews Portal - Environment Variables
# Copy this file to .env and adjust the values according to your environment.
# =============================================================================

# -----------------------------------------------------------------------------
# 0. Multi-Site Instance Identity (Change ONLY this section when cloning a new site!)
# -----------------------------------------------------------------------------
# Unique lowercase identifier per website (e.g. web1, web2, techradar).
# Automatically prefixes container names, volumes, DB name, and MinIO bucket!
APP_SLUG=heygoodly
JAVA_TOOL_OPTIONS=-Xms256m -Xmx640m -XX:+UseG1GC

# -----------------------------------------------------------------------------
# 1. Environment & Profiles
# -----------------------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
NODE_ENV=development

# -----------------------------------------------------------------------------
# 2. Server Ports
# -----------------------------------------------------------------------------
SERVER_PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# 3. PostgreSQL Database
# -----------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=heygoodly_db
DB_USER=heygoodly_user
DB_PASSWORD=heygoodly_secret_password_2026

# Docker Compose PostgreSQL service settings
POSTGRES_PORT=5432
POSTGRES_DB=heygoodly_db
POSTGRES_USER=heygoodly_user
POSTGRES_PASSWORD=heygoodly_secret_password_2026

# Database Connection Pool (HikariCP)
DB_POOL_MAX_SIZE=20
DB_POOL_MIN_IDLE=5
DB_POOL_IDLE_TIMEOUT=300000
DB_POOL_CONN_TIMEOUT=20000

# Liquibase & JPA
LIQUIBASE_ENABLED=true
LIQUIBASE_DROP_FIRST=false
JPA_DDL_AUTO=validate
JPA_SHOW_SQL=false
JPA_FORMAT_SQL=false

# -----------------------------------------------------------------------------
# 4. Redis In-Memory Cache & Click Aggregator
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=heygoodly_redis_pass_2026
REDIS_TIMEOUT_MS=5000

# -----------------------------------------------------------------------------
# 5. MinIO Object Storage (S3-Compatible)
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=heygoodly_minio_admin
MINIO_ROOT_PASSWORD=heygoodly_minio_pass_2026
MINIO_BUCKET_NAME=heygoodly-media

# -----------------------------------------------------------------------------
# 6. Security & JWT Authentication
# -----------------------------------------------------------------------------
# Base64-encoded HMAC-SHA256 Secret (At least 256 bits)
JWT_SECRET=c2VjdXJlX2hleWdvb2RseV9hZmZpbGlhdGVfcG9ydGFsX2p3dF9zZWNyZXRfa2V5XzIwMjY=
JWT_ACCESS_TOKEN_EXPIRATION_MS=86400000   # 24 Hours
JWT_REFRESH_TOKEN_EXPIRATION_MS=604800000 # 7 Days

# Two-Factor Authentication (2FA TOTP)
TWO_FACTOR_ISSUER=HeyGoodlyProCMS

# -----------------------------------------------------------------------------
# 7. File Storage & Uploads
# -----------------------------------------------------------------------------
STORAGE_LOCAL_PATH=/var/www/heygoodly/uploads
STORAGE_MAX_FILE_SIZE_BYTES=10485760 # 10MB
STORAGE_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp
MULTIPART_MAX_FILE_SIZE=10MB
MULTIPART_MAX_REQUEST_SIZE=20MB

# -----------------------------------------------------------------------------
# 8. CORS & Cross-Origin Requests
# -----------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

# -----------------------------------------------------------------------------
# 9. Affiliate Outbound Redirects & Tracking
# -----------------------------------------------------------------------------
AFFILIATE_DEFAULT_FALLBACK_URL=https://heygoodly.com

# -----------------------------------------------------------------------------
# 10. Frontend Client Portal & Public URL
# -----------------------------------------------------------------------------
# Public API URL called from users' browsers (e.g. https://api.heygoodly.com in production)
NEXT_PUBLIC_API_URL=http://localhost:8080
# Internal Docker SSR API URL (overridden automatically to http://backend:8080 in docker-compose.yml)
BACKEND_INTERNAL_URL=http://localhost:8080
# Canonical Public Site URL (e.g. https://heygoodly.com in production)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# 11. Logging Levels
# -----------------------------------------------------------------------------
LOG_LEVEL_ROOT=INFO
LOG_LEVEL_APP=DEBUG
LOG_LEVEL_SECURITY=INFO

