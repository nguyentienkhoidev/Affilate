# =============================================================================
# Quick Duplicate Site Config (.env.site.example -> copy to .env)
# Used with: docker compose -f docker-compose.site.yml up -d --build
# Shared Infra (run ONCE):
#   docker compose -f docker-compose.minio.yml up -d
#   docker compose -f docker-compose.nginx.yml up -d
# =============================================================================

# 1. Unique Site Slug (auto-names containers, DB, volumes & MinIO bucket "${APP_SLUG}-media")
APP_SLUG=web2

# 2. Localhost Bind Ports (Web 1: 3001/8081 | Web 2: 3002/8082 | Web 3: 3003/8083)
FRONTEND_PORT=3002
BACKEND_PORT=8082

# 3. Domain & Public Endpoints (Nginx routes both / and /api/ on the same domain!)
NEXT_PUBLIC_SITE_URL=https://web2-domain.com
NEXT_PUBLIC_API_URL=https://web2-domain.com
CORS_ALLOWED_ORIGINS=https://web2-domain.com,https://www.web2-domain.com
MINIO_PUBLIC_URL=https://media.yourdomain.com

# 4. Shared MinIO Credentials (must match docker-compose.minio.yml)
MINIO_ROOT_USER=heygoodly_minio_admin
MINIO_ROOT_PASSWORD=change_me_minio_secret_2026

# 5. Isolated Site Secrets (generate new JWT_SECRET via: openssl rand -base64 48)
POSTGRES_PASSWORD=change_me_db_secret_2026
REDIS_PASSWORD=change_me_redis_secret_2026
JWT_SECRET=c2VjdXJlX2hleWdvb2RseV9hZmZpbGlhdGVfcG9ydGFsX2p3dF9zZWNyZXRfa2V5XzIwMjY=

# 6. JVM RAM Cap (Optimized for running 2-3 sites on 8GB RAM VPS)
JAVA_TOOL_OPTIONS=-Xms256m -Xmx640m -XX:+UseG1GC
